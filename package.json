{
  "name": "beerjs-skopje",
  "type": "module",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "dev": "mkdir -p data/uploads && astro dev",
    "start": "mkdir -p data/uploads && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "mkdir -p data/uploads && node ./dist/server/entry.mjs",
    "cms:import": "mkdir -p data/uploads && emdash seed seed/seed.json --database ./data/emdash.db --uploads-dir ./data/uploads --on-conflict skip",
    "cms:check": "emdash migrate --check --database ./data/emdash.db",
    "astro": "astro",
    "cms:pull": "bash scripts/cms-pull.sh"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.1",
    "@emdash-cms/admin": "1.3.1",
    "@iconify-json/simple-icons": "^1.2.100",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "astro-compress": "^2.4.3",
    "astro-icon": "^1.2.0",
    "astro-seo": "^1.2.0",
    "date-fns": "^4.4.0",
    "emdash": "1.3.1",
    "github-slugger": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@iconify-icon/solid": "^3.0.5",
    "@iconify-json/mdi": "^1.2.3",
    "@tailwindcss/typography": "^0.5.20",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@11.24.0",
  "emdash": {
    "seed": "seed/seed.json"
  }
}
