---
import BeerJS from "./BeerJS.astro";
import { Icon } from "astro-icon/components";
import LanguagePicker from "./LanguagePicker.astro";

import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getSocialLinks } from "../lib/content";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const socials = await getSocialLinks();

const headerLinks = ["discord", "youtube"].flatMap((id) =>
  socials.filter((s) => s.id === id),
);
---

<nav class="grid grid-cols-12 py-8">
  <div class="col-span-2 hidden xl:flex"></div>
  <div
    class="flex w-full items-center justify-between lg:justify-center gap-16 text-white font-jetbrains font-normal text-[18px] grow col-span-12 px-8 lg:px-0 lg:col-span-8"
  >
    <a
      href={`${getRelativeLocaleUrl(lang, "/")}`}
      id="logo"
      class="w-[50px] hidden lg:flex xl:hidden lg:w-[66px] lg:min-w-[66px] hover:brightness-110"
      aria-label="Home"
    >
      <BeerJS />
    </a>
    <a
      href={`${getRelativeLocaleUrl(lang, "/about")}`}
      class="hidden lg:inline border-b-2 border-dashed border-b-transparent hover:border-b-2 hover:border-byellow"
      >{t("nav.about")}</a
    >
    <a
      href={`${getRelativeLocaleUrl(lang, "/blog")}`}
      class="hidden lg:inline border-b-2 border-dashed border-b-transparent hover:border-b-2 hover:border-byellow"
      >{t("nav.blog")}</a
    >
    <a
      href={`${getRelativeLocaleUrl(lang, "/")}`}
      id="logo"
      class="flex lg:hidden xl:flex w-[50px] lg:w-[66px] lg:min-w-[66px] hover:brightness-110"
      aria-label="Home"
    >
      <BeerJS />
    </a>
    <a
      href={`${getRelativeLocaleUrl(lang, "/contact")}`}
      class="hidden lg:inline border-b-2 border-dashed border-b-transparent hover:border-b-2 hover:border-byellow"
      >{t("nav.contact")}</a
    >
    <a
      href={`${getRelativeLocaleUrl(lang, "/take-part")}`}
      class="hidden lg:inline border-b-2 border-dashed border-b-transparent hover:border-b-2 hover:border-byellow"
      >{t("nav.take-part")}</a
    >
    <button
      class="w-[30px] text-byellow cursor-pointer inline-block lg:hidden hover:brightness-125"
      id="menu-button"
      aria-label="Open menu"
      aria-controls="drawer"
    >
      <Icon name="mdi:menu" class="w-[32px] h-[32px]" />
    </button>
  </div>
  <div
    class="gap-4 items-center justify-end lg:col-span-4 xl:col-span-2 hidden lg:flex"
  >
    {
      headerLinks.map((s) => (
        <a href={s.url} aria-label={s.name} class="text-white fill-current">
          <Icon name={s.icon} class="w-[32px] h-[32px]" />
        </a>
      ))
    }
    <div class="flex items-center pr-4">
      <LanguagePicker />
    </div>
  </div>
</nav>

<dialog id="drawer" class="drawer" closedby="any" aria-label="Menu">
  <form method="dialog" class="flex justify-end">
    <button
      class="text-byellow cursor-pointer hover:brightness-125"
      aria-label="Close menu"
    >
      <Icon name="mdi:close" class="w-[32px] h-[32px]" />
    </button>
  </form>
  <div
    class="flex flex-col gap-6 text-white font-jetbrains font-normal text-[22px] px-10 py-12"
  >
    <a href={`${getRelativeLocaleUrl(lang, "/about")}`}>{t("nav.about")}</a>
    <a href={`${getRelativeLocaleUrl(lang, "/blog")}`}>{t("nav.blog")}</a>
    <a href={`${getRelativeLocaleUrl(lang, "/contact")}`}>{t("nav.contact")}</a>
    <a href={`${getRelativeLocaleUrl(lang, "/take-part")}`}
      >{t("nav.take-part")}</a
    >
    <div class="flex gap-2 pt-10">
      {
        headerLinks.map((s) => (
          <a href={s.url} aria-label={s.name} class="text-white fill-current">
            <Icon name={s.icon} class="w-[32px] h-[32px]" />
          </a>
        ))
      }
    </div>
    <div>
      <LanguagePicker align="start" />
    </div>
  </div>
</dialog>

<script>
  const drawer = () => document.querySelector<HTMLDialogElement>("#drawer");

  const isBackdropClick = (dialog: HTMLDialogElement, event: MouseEvent) => {
    if (event.target !== dialog) return false;
    const rect = dialog.getBoundingClientRect();
    return (
      event.clientX < rect.left ||
      event.clientX > rect.right ||
      event.clientY < rect.top ||
      event.clientY > rect.bottom
    );
  };

  document.addEventListener("click", (event) => {
    const dialog = drawer();
    if (!dialog) return;
    const target = event.target as Element;

    if (target.closest("#menu-button")) {
      dialog.showModal();
      return;
    }

    // Close on link navigation, because the navigation persists across
    // page swaps. Safari has no closedby, so handle backdrop clicks here.
    const followsLink = dialog.contains(target) && target.closest("a");
    const missingClosedBy = !("closedBy" in HTMLDialogElement.prototype);
    if (followsLink || (missingClosedBy && isBackdropClick(dialog, event))) {
      dialog.close();
    }
  });
</script>

