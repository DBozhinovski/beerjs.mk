---
import { SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";
import { Font, getImage } from "astro:assets";
import type { MediaValue } from "emdash";
import beerjsLabel from "../assets/beerjs-label.png";
import { getLangFromUrl } from "../i18n/utils";
import { mediaUrl } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  type?: string;
  image?: MediaValue | null;
}

const { title, description, type, image } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const fullTitle = title ? `${title} | BeerJS Skopje` : "BeerJS Skopje";
const socialImagePath = image
  ? mediaUrl(image)
  : (await getImage({ src: beerjsLabel, width: 1200, format: "png" })).src;
const socialImageUrl = new URL(socialImagePath, Astro.site).href;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <SEO
    title={title}
    titleDefault="BeerJS Skopje"
    titleTemplate="%s | BeerJS Skopje"
    description={description}
    openGraph={{
      basic: {
        title: fullTitle,
        type: type || "website",
        image: socialImageUrl,
      },
    }}
    twitter={{
      card: "summary_large_image",
      creator: "@d_bozhinovski",
      title: fullTitle,
      image: socialImageUrl,
      description,
    }}
    extend={{
      link: [{ rel: "icon", href: "/favicon.svg" }],
    }}
  />
  <Font
    cssVariable="--font-jetbrains-mono"
    preload={[
      { subset: "latin" },
      ...(lang === "mk" ? [{ subset: "cyrillic" }] : []),
    ]}
  />
  <Font cssVariable="--font-inter-sans" />

  <link rel="sitemap" href="/sitemap.xml" />

  <script
    defer
    src="https://umami.foundry.mk/script.js"
    data-website-id="41bee8e9-e50d-4b93-8878-6fdcebaa2c68"></script>

  <ClientRouter />
</head>
